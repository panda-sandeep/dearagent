/**
 * DearAgent — self-hosted email inboxes for AI agents.
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * This is the template. The real config, wrangler.jsonc, is generated from it and
 * git-ignored because it holds values specific to your Cloudflare account.
 * `npm run setup` copies this file and fills in the REPLACE_ME placeholders;
 * or copy it yourself: cp wrangler.example.jsonc wrangler.jsonc
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dearagent",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"logs": { "enabled": true }
	},
	// Bindings ------------------------------------------------------------
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dearagent",
			"database_id": "REPLACE_ME_D1_DATABASE_ID",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "ATTACHMENTS",
			"bucket_name": "dearagent-attachments"
		}
	],
	"send_email": [
		{
			"name": "EMAIL"
			// Uncomment for local dev to send real email through `wrangler dev`:
			// "remote": true
		}
	],
	// Daily retention purge (see RETENTION_DAYS below).
	"triggers": {
		"crons": ["17 3 * * *"]
	},
	// Email Routing rules owned by this Worker, applied on `wrangler deploy`.
	// "*@<domain>" is the catch-all: every address at the domain reaches email() below.
	// Must match EMAIL_DOMAINS. (Newer wrangler feature; editors may flag it against the JSON schema.)
	"addresses": ["*@REPLACE_ME.example.com"],
	// Configuration -------------------------------------------------------
	// Secrets (set with `wrangler secret put <NAME>`, never in this file):
	//   API_KEY          required — bearer token for the REST API and MCP endpoint
	"vars": {
		// Comma-separated list of domains this Worker accepts mail for and may send from.
		"EMAIL_DOMAINS": "REPLACE_ME.example.com",
		// Days to keep messages. 0 = keep forever.
		"RETENTION_DAYS": "30",
		// Auto-create an inbox row for any address at EMAIL_DOMAINS ("true"), or
		// reject mail for addresses that were not created via POST /inboxes ("false").
		"ALLOW_UNKNOWN_INBOX": "true",
		// Keep the raw MIME in R2 so GET /inboxes/:id/messages/:mid/raw works.
		"STORE_RAW": "false",
		// Attachments larger than this are recorded (metadata) but their bytes are not stored.
		"MAX_ATTACHMENT_BYTES": "10485760",
		// Display name used on outbound mail when the request does not set one.
		"DEFAULT_FROM_NAME": "",
		// Per-attempt webhook delivery timeout.
		"WEBHOOK_TIMEOUT_MS": "10000"
	}
	// Optional: serve the API on your own hostname.
	// "routes": [{ "pattern": "mail-api.example.com", "custom_domain": true }]
}
